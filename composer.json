{
    "name": "esanj/file-browser",
    "description": "A Laravel package for iframe-based file management",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "file-manager", "file-browser"],
    "authors": [
        {
            "name": "MOHAMMAD Ali Heidari",
            "email": "h.mohammad026@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "esanj/auth-bridge": ">=1.0.0 <2.0.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Esanj\\FileBrowser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esanj\\FileBrowser\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\FileBrowser\\FileBrowserServiceProvider"
            ]
        }
    }
}
